# Dependencies
node_modules

# Claude Code workspace state (auto-memory, scheduled-task locks, etc.)
.claude

# pnpm content-addressed store (can leak through the dev bind mount)
.pnpm-store

# Logs
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temp directories
.temp
.tmp
.cache

# Yarn
**/.yarn/cache
**/.yarn/*state*

# Generated dirs
dist
apps/site/.repl-cache
apps/site/public/_pagefind

# Generated per-demo stylesheets (composed from scripts/demo-styles/ at
# dev/build time; source of truth is registry.mjs + each demo's styles.json)
apps/site/docs-demos/*/styles.css

# esbuild metafile dumps from the bundle-size analysis tooling
analysis/meta

# Volar / mkdist Vue declaration stubs. These belong in dist/ only —
# the mkdist preset (build.config.ts) emits them at pack time. If a
# Volar emit-on-save or a misconfigured vue-tsc run drops them next
# to source .vue files, this rule keeps them out of commits. See
# test/source-shape.test.ts for the standing CI tripwire.
**/*.d.vue.ts
**/*.vue.d.ts

# TypeScript
/*.tsbuildinfo
*.d.ts.map

# Nuxt
.nuxt
.output
.data
**/.data
.vercel_build_output
.build-*
.netlify

# Env
.env
*.env.local
*.local

# Testing
reports
coverage
*.lcov
.nyc_output
/.husky/_

# ESLint
.eslintcache

# Claude Code (auto-memory + plan files; per-developer, not committed)
.claude

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Intellij idea
*.iml
.idea

# OSX
.DS_Store
.AppleDouble
.LSOverride
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
Thumbs.db
*.swp

# Tarball files
package
*.tgz

# Binaries
*.exe
*.dll
*.so
*.dylib

# Temp files
/tmp
*.tmp
*.temp
*.pid
*.seed
*.pid.lock