# Dependencies
node_modules
# Except the dist-flavor fixture's committed self-install: a symlink to
# the repo root, so the fixture resolves attaform through the real
# exports map (Node self-reference stops at the fixture's own
# package.json, so a plain walk-up would never find the package).
!test/fixtures/dist-flavor/node_modules

# Claude Code workspace state (auto-memory, scheduled-task locks, etc.)
.claude

# pnpm content-addressed store (can leak through the dev bind mount)
.pnpm-store

# Logs
*.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Temp directories
.temp
.tmp
.cache

# Yarn
**/.yarn/cache
**/.yarn/*state*

# Generated dirs
dist
apps/site/.repl-cache
apps/site/public/_pagefind

# Generated per-demo stylesheets (composed from scripts/demo-styles/ at
# dev/build time; source of truth is registry.mjs + each demo's styles.json)
apps/site/docs-demos/*/styles.css

# Generated AI-agent surface (composed by scripts/generate-llms.mjs on
# dev/build; sources of truth are llms.template.md + docs/**/*.md +
# docs-demos/quick-start/snippet.vue for the text files, skills/attaform/**
# for the served skill mirror + alias, and docs/**/*.md for the per-page
# cleaned Markdown endpoints)
apps/site/public/llms.txt
apps/site/public/llms-full.txt
apps/site/public/skill.md
apps/site/public/skills/
apps/site/public/docs/

# Doc-snippet type-check fixtures, extracted from docs/**/*.md + the llms
# template by scripts/check-doc-snippets.mjs on every run (source of truth is
# the markdown; these are regenerated, never committed)
tests/fixtures/doc-snippets/.generated

# esbuild metafile dumps from the bundle-size analysis tooling
analysis/meta

# Volar / mkdist Vue declaration stubs. These belong in dist/ only —
# the mkdist preset (build.config.ts) emits them at pack time. If a
# Volar emit-on-save or a misconfigured vue-tsc run drops them next
# to source .vue files, this rule keeps them out of commits. See
# test/source-shape.test.ts for the standing CI tripwire.
**/*.d.vue.ts
**/*.vue.d.ts

# TypeScript
/*.tsbuildinfo
*.d.ts.map

# Nuxt
.nuxt
.output
.data
**/.data
.vercel_build_output
.build-*
.netlify

# Env
.env
*.env.local
*.local

# Testing
reports
coverage
*.lcov
.nyc_output
/.husky/_

# ESLint
.eslintcache

# Generated by unplugin-auto-import / unplugin-vue-components when the Nuxt UI
# test slice runs (vitest.nuxt-ui.config.ts). Suppressed via autoImport.dts /
# components.dts: false, but ignored here as a safety net.
auto-imports.d.ts
components.d.ts

# Claude Code (auto-memory + plan files; per-developer, not committed)
.claude

# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets

# Intellij idea
*.iml
.idea

# OSX
.DS_Store
.AppleDouble
.LSOverride
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk
Thumbs.db
*.swp

# Tarball files
package
*.tgz

# Binaries
*.exe
*.dll
*.so
*.dylib

# Temp files
/tmp
*.tmp
*.temp
*.pid
*.seed
*.pid.lock