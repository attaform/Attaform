{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",

  // Calibration for fallow's static analysis. The guiding rule mirrors
  // scripts/check-eager-size.mjs: only suppress PROVEN false positives,
  // and document why each one is noise. Anything fallow flags that is a
  // genuine candidate (e.g. an actually-unreferenced devDep) is left
  // visible on purpose so the signal stays honest.

  // ── Dependencies ────────────────────────────────────────────────
  // Only entries fallow cannot trace because the consumer is a config
  // file / plugin-host auto-discovery, or the dep is deliberately
  // peer / transitive / hoisted / resolved-by-name at runtime / resolved
  // by the editor's language server. Eight devDeps fallow flagged with no
  // code or config reference (@typescript-eslint/*, @nuxt/eslint-config,
  // eslint-config-prettier, @nuxt/module-builder, changelogen, immer,
  // vite-plugin-dts) were genuinely unused and have been removed, not
  // suppressed, so they no longer surface here.
  "ignoreDependencies": [
    // Consumed by size-limit's preset auto-discovery; never imported by
    // name, so fallow's module graph can't see the edge.
    "@size-limit/preset-small-lib",
    // Required peer of @fast-check/vitest. Property tests import `fc`
    // from the wrapper, which re-exports fast-check.
    "fast-check",
    // Type-only import in .size-limit.js (`import('esbuild').BuildOptions`)
    // plus transitive runtime use by size-limit and check-eager-size.mjs.
    // Deliberately not a root direct dep (zero-runtime-deps posture).
    "esbuild",
    // apps/site demos + nuxt.config.ts import `zod` through the
    // root-hoisted copy rather than declaring it in apps/site/package.json.
    // Arguably real workspace hygiene; suppressed as a deliberate hoist.
    "zod",
    // apps/site/nuxt.config.ts; `npm:zod@^3.24` alias fallow doesn't
    // decode, same root-hoist story as `zod`.
    "zod-v3",
    // Optional peerDependency of @nuxt/content (apps/site content
    // pipeline). The native SQLite connector @nuxt/content loads BY NAME
    // at runtime for the local content database, so fallow's module graph
    // can't see the edge. Drop it and @nuxt/content falls back to its
    // bundled WASM SQLite; declaring it deliberately picks the faster
    // native driver.
    "better-sqlite3",
    // Optional peerDependency of nuxt-og-image (pulled in by @nuxtjs/seo).
    // The docs site renders OG images through satori
    // (apps/site/components/OgImage/Default.satori.vue), which
    // nuxt-og-image loads by name; no authored source imports it directly.
    "satori",
    // Workspace-pinned Vue language toolchain. No code or build step
    // imports these; the editor's Volar LSP resolves them from
    // node_modules to provide .vue IntelliSense (nvim's vue_ls binary is
    // node_modules/.bin/vue-language-server, and the TS server loads
    // @vue/typescript-plugin for .vue type info). Removing them breaks
    // editor IntelliSense, so they stay as devDeps even though fallow's
    // module graph sees no importer.
    "@vue/language-server",
    "@vue/typescript-plugin"
  ],

  // ── Unresolved imports ──────────────────────────────────────────
  // The lone unresolved import is a Docker-absolute path string
  // (`/app/src/<entry>.ts`) that fallow's tokenizer lifts out of a
  // docstring in test/docs-site-source-alias-symmetry.test.ts (the
  // jiti-shim staleness explanation). No real import; never resolvable
  // on the host.
  "ignoreUnresolvedImports": ["/app/**"],

  // ── Entry points ────────────────────────────────────────────────
  // Standalone manual-regeneration scripts fallow can't reach from any
  // auto-detected entry point: they aren't wired into package.json
  // scripts, they're run by hand when their committed output needs a
  // refresh. Declaring them as entry points reflects the truth (they ARE
  // roots) rather than suppressing a "dead file" that isn't dead.
  //   - scripts/build-bestpractices-json.mjs regenerates .bestpractices.json
  //     (the OpenSSF Best Practices badge data).
  //   - apps/site/scripts/generate-favicons.mjs regenerates the committed
  //     favicons from the source SVG (imports @resvg/resvg-js).
  "entry": ["scripts/build-bestpractices-json.mjs", "apps/site/scripts/generate-favicons.mjs"],

  // ── Duplication ─────────────────────────────────────────────────
  // Duplication is a source-DRY signal, so scope it to the shipped
  // library. The bulk of the raw 18.6% is DELIBERATE: the zod v3/v4
  // parity test batteries (mirrored by design) and the parallel
  // teaching demos. Excluding test/bench/scripts/apps leaves real src/
  // duplication, which still surfaces the intentional v3<->v4 adapter
  // twin for inspection.
  "duplicates": {
    "ignore": ["test/**", "bench/**", "scripts/**", "apps/site/**"],
    // Strip import blocks from clone detection — sorted import lists
    // look alike everywhere and aren't copy-paste worth refactoring.
    "ignoreImports": true
  },

  // ── Complexity / hotspots ───────────────────────────────────────
  // Measure product code (src/ library + apps/site docs site). Drop
  // test trees (a 600-line `describe` arrow is not a "large function")
  // and one-off build/release scripts.
  "health": {
    "ignore": ["test/**", "bench/**", "scripts/**"]
  }
}
